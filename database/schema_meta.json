      "attributes": [
        {
          "name": "id",
          "type": "bigint identity",
          "key": "PK",
          "nullable": false,
          "description": "ID события"
        },
        {
          "name": "occurred_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Время события"
        },
        {
          "name": "event_type",
          "type": "varchar(32)",
          "key": "",
          "nullable": false,
          "description": "Тип из перечня"
        },
        {
          "name": "actor_id",
          "type": "uuid",
          "key": "historical",
          "nullable": true,
          "description": "Исторический участник без FK"
        },
        {
          "name": "object_type",
          "type": "varchar(32)",
          "key": "",
          "nullable": true,
          "description": "Тип объекта"
        },
        {
          "name": "object_id",
          "type": "uuid",
          "key": "historical",
          "nullable": true,
          "description": "Исторический ID объекта без FK"
        },
        {
          "name": "result",
          "type": "varchar(7)",
          "key": "",
          "nullable": false,
          "description": "success/failure/denied"
        }
      ],
      "constraints": [
        "CHECK тип и результат",
        "object_type и object_id одновременно заданы или NULL",
        "Хранение 30 дней, доступ — C09"
      ]
    },
    {
      "name": "backup_run",
      "title": "Копирование и восстановление",
      "description": "Метаданные инфраструктурных операций; сами архивы хранятся вне рабочего узла.",
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "key": "PK",
          "nullable": false,
          "description": "ID запуска"
        },
        {
          "name": "started_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Начало"
        },
        {
          "name": "finished_at",
          "type": "timestamptz",
          "key": "",
          "nullable": true,
          "description": "Завершение"
        },
        {
          "name": "operation_type",
          "type": "varchar(7)",
          "key": "",
          "nullable": false,
          "description": "backup/restore"
        },
        {
          "name": "status",
          "type": "varchar(7)",
          "key": "",
          "nullable": false,
          "description": "running/success/failure"
        },
        {
          "name": "archive_key",
          "type": "varchar(200)",
          "key": "",
          "nullable": false,
          "description": "Непустой технический ключ архива"
        },
        {
          "name": "checksum",
          "type": "char(64)",
          "key": "",
          "nullable": true,
          "description": "SHA-256 архива"
        },
        {
          "name": "bytes_count",
          "type": "bigint",
          "key": "",
          "nullable": true,
          "description": "Размер архива в байтах"
        }
      ],
      "constraints": [
        "CHECK согласованность статуса и времени",
        "Для success обязательны checksum и bytes_count",
        "Строка не доказывает существование архива"
      ]
    }
