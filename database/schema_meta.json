        {
          "name": "completed_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Фиксация результата"
        }
      ],
      "constraints": [
        "PK(owner_id,operation_key)",
        "ON DELETE SET NULL(subscription_id)",
        "CHECK живая ссылка равна историческому ID"
      ]
    },
    {
      "name": "login_attempt",
      "title": "Попытка входа",
      "description": "Временные записи для скользящих окон 15 минут; IP заменен HMAC.",
      "attributes": [
        {
          "name": "id",
          "type": "bigint identity",
          "key": "PK",
          "nullable": false,
          "description": "ID попытки"
        },
        {
          "name": "account_id",
          "type": "uuid",
          "key": "FK",
          "nullable": true,
          "description": "Учетная запись, если найдена"
        },
        {
          "name": "ip_digest",
          "type": "char(64)",
          "key": "",
          "nullable": false,
          "description": "HMAC IP; исходного IP нет"
        },
        {
          "name": "attempted_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Время попытки"
        },
        {
          "name": "outcome",
          "type": "varchar(16)",
          "key": "",
          "nullable": false,
          "description": "ok/wrong_password/blocked/invalid"
        }
      ],
      "constraints": [
        "FK account ON DELETE SET NULL",
        "CHECK исход и хеш; очистка по времени — C09"
      ]
    },
    {
      "name": "audit_event",
