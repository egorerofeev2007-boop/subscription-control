{
  "dbms": "PostgreSQL 16.x",
  "schema": "subscription_control",
  "verification_count": 49,
  "tables": [
    {
      "name": "app_user",
      "title": "Пользователь",
      "description": "Учетная запись, часовой пояс и срок ограничения входа.",
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "key": "PK",
          "nullable": false,
          "description": "Идентификатор пользователя"
        },
        {
          "name": "email",
          "type": "varchar(254)",
          "key": "UQ lower",
          "nullable": false,
          "description": "Почта; уникальна без учета регистра"
        },
        {
          "name": "password_hash",
          "type": "varchar(256)",
          "key": "",
          "nullable": false,
          "description": "Адаптивный хеш Django; не пароль"
        },
        {
          "name": "timezone",
          "type": "varchar(64)",
          "key": "",
          "nullable": false,
          "description": "Идентификатор IANA; проверяет C03"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Момент регистрации"
        },
        {
          "name": "blocked_until",
          "type": "timestamptz",
          "key": "",
          "nullable": true,
          "description": "Окончание ограничения входа"
        }
      ],
      "constraints": [
        "PK(id)",
        "UNIQUE INDEX lower(email)",
        "CHECK email без пробелов, хеш и timezone не пусты"
      ]
    },
    {
      "name": "category",
      "title": "Категория",
      "description": "Личный набор готовых и созданных вручную категорий.",
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "key": "PK",
          "nullable": false,
          "description": "Идентификатор категории"
        },
        {
          "name": "owner_id",
          "type": "uuid",
          "key": "FK",
          "nullable": false,
          "description": "Владелец"
        },
        {
          "name": "name",
          "type": "varchar(50)",
          "key": "UQ owner/name",
          "nullable": false,
          "description": "Название"
        }
      ],
      "constraints": [
        "UNIQUE(owner_id,name)",
        "UNIQUE(id,owner_id)",
        "CHECK длина 1–50, без пробелов по краям"
      ]
    },
    {
      "name": "subscription",
      "title": "Подписка",
      "description": "Личная карточка; текущая цена хранится только в версиях условий.",
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "key": "PK",
          "nullable": false,
          "description": "Идентификатор подписки"
        },
        {
          "name": "owner_id",
          "type": "uuid",
          "key": "FK",
          "nullable": false,
          "description": "Владелец"
        },
        {
          "name": "category_id",
          "type": "uuid",
          "key": "FK composite",
          "nullable": false,
          "description": "Собственная категория"
        },
        {
          "name": "name",
          "type": "varchar(100)",
          "key": "",
          "nullable": false,
          "description": "Название услуги"
        },
        {
          "name": "deactivated_from",
          "type": "date",
          "key": "",
          "nullable": true,
          "description": "С этой даты события не учитываются"
        },
        {
          "name": "row_version",
          "type": "bigint",
          "key": "",
          "nullable": false,
          "description": "Счетчик для условного UPDATE"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Создание"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Изменение"
        }
      ],
      "constraints": [
        "UNIQUE(id,owner_id)",
        "FK(category_id,owner_id)",
        "CHECK имя 1–100, дата 2000–2100, row_version≥1"
      ]
    },
    {
      "name": "condition_version",
      "title": "Версия условий",
      "description": "Цена и правило повторения, действующие с календарной даты.",
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "key": "PK",
          "nullable": false,
          "description": "Идентификатор версии"
        },
        {
          "name": "subscription_id",
          "type": "uuid",
          "key": "FK",
          "nullable": false,
          "description": "Подписка"
        },
        {
          "name": "valid_from",
          "type": "date",
          "key": "UQ sub/date",
          "nullable": false,
          "description": "Начало действия"
        },
        {
          "name": "anchor_date",
          "type": "date",
          "key": "",
          "nullable": false,
          "description": "Исходная привязка расписания"
        },
        {
          "name": "price_kopecks",
          "type": "bigint",
          "key": "",
          "nullable": false,
          "description": "Цена в копейках"
        },
        {
          "name": "period_count",
          "type": "smallint",
          "key": "",
          "nullable": false,
          "description": "Число периодов"
        },
        {
          "name": "period_unit",
          "type": "varchar(5)",
          "key": "",
          "nullable": false,
          "description": "week/month/year"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Создание версии"
        }
      ],
      "constraints": [
        "UNIQUE(subscription_id,valid_from)",
        "CHECK копейки 1–99999999; период 1–120",
        "CHECK даты 2000–2100; FK CASCADE"
      ]
    },
    {
      "name": "auth_session",
      "title": "Сеанс",
      "description": "Серверное состояние; случайный ключ cookie хранится только как хеш.",
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "key": "PK",
          "nullable": false,
          "description": "ID сеанса"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "key": "FK",
          "nullable": false,
          "description": "Пользователь"
        },
        {
          "name": "token_hash",
          "type": "char(64)",
          "key": "UQ",
          "nullable": false,
          "description": "Хеш ключа сеанса"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Создание"
        },
        {
          "name": "last_seen_at",
          "type": "timestamptz",
          "key": "",
          "nullable": false,
          "description": "Последняя активность"
        },
        {
          "name": "revoked_at",
          "type": "timestamptz",
          "key": "",
          "nullable": true,
          "description": "Отзыв"
        }
      ],
      "constraints": [
        "UNIQUE(token_hash)",
        "CHECK хеш 64 hex, монотонные отметки; простой проверяет C03"
      ]
    },
    {
      "name": "request_operation",
      "title": "Операция запроса",
      "description": "Защита повторного создания; ключ и исторический ID сохраняются после удаления.",
      "attributes": [
        {
          "name": "owner_id",
          "type": "uuid",
          "key": "PK, FK",
          "nullable": false,
          "description": "Владелец"
        },
        {
          "name": "operation_key",
          "type": "uuid",
          "key": "PK",
          "nullable": false,
          "description": "Ключ операции"
        },
        {
          "name": "payload_hash",
          "type": "char(64)",
          "key": "",
          "nullable": false,
          "description": "Хеш нормализованного ввода"
        },
        {
          "name": "original_result_id",
          "type": "uuid",
          "key": "historical",
          "nullable": false,
          "description": "Исходный ID результата без FK"
        },
        {
          "name": "subscription_id",
          "type": "uuid",
          "key": "FK composite",
          "nullable": true,
          "description": "Живой результат; NULL после удаления"
        },
        {
          "name": "result_version",
          "type": "bigint",
          "key": "",
          "nullable": false,
          "description": "Версия при создании"
